NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Google Calendar connection (a separate, optional consent flow from sign-in).
# Register APP_URL/api/calendar/callback on the Google OAuth web client.
APP_URL=http://localhost:3000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# 32 random bytes encoded as base64. Keep stable across deployments.
CALENDAR_TOKEN_KEY=
# Server-only scheduled worker; never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional override when hosting integrations manage SUPABASE_SECRET_KEY:
WEPLANGO_SUPABASE_SECRET_KEY=
# Legacy fallback, only for existing configurations:
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
